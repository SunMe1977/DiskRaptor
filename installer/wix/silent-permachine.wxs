<?xml version="1.0" encoding="utf-8"?>
<!--
  Standalone per-MACHINE MSI for the Microsoft Store.

  The Store's background-install test cannot detect a per-user install
  (files in %LOCALAPPDATA%, uninstall key in HKCU), which fails certification
  with:
    - "We could not determine whether your app installs in the background"
    - "We could not identify the app name and publisher in Add/Remove Programs"

  So the Store package installs per-machine (Program Files, HKLM uninstall
  key), which the Store can detect. Install is fully silent (`msiexec /i ... /qn`);
  the UAC elevation prompt is explicitly allowed by the Store's MSI/EXE
  requirements ("silent install required, UAC dialog is allowed").

  Compiled from this source with candle/light, because Tauri's WiX bundler
  cannot emit exactly this package.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Product Id="*"
             Name="DiskRaptor"
             Language="1033"
             Version="$(var.Version)"
             Manufacturer="Hansjoerg Hofer"
             UpgradeCode="{339ED948-13D3-59F2-9A8E-5C0237C7938C}">

        <Package Id="*"
                 Keywords="Installer"
                 Description="DiskRaptor Setup"
                 Manufacturer="Hansjoerg Hofer"
                 InstallerVersion="500"
                 Compressed="yes"
                 InstallScope="perMachine"
                 Languages="1033"
                 SummaryCodepage="1252"
                 Platform="x64"/>

        <!-- Same UpgradeCode as earlier builds so an existing installation is
             detected and upgraded. -->
        <MajorUpgrade Schedule="afterInstallInitialize"
                      AllowSameVersionUpgrades="yes"
                      DowngradeErrorMessage="A newer version of DiskRaptor is already installed."/>

        <MediaTemplate EmbedCab="yes"/>

        <Icon Id="ProductIcon" SourceFile="$(var.IconPath)"/>
        <Property Id="ARPPRODUCTICON" Value="ProductIcon"/>
        <Property Id="ARPNOREPAIR" Value="yes"/>
        <Property Id="ARPNOMODIFY" Value="1"/>
        <Property Id="ARPURLINFOABOUT" Value="https://github.com/SunMe1977/DiskRaptor"/>
        <Property Id="ARPHELPLINK" Value="https://github.com/SunMe1977/DiskRaptor"/>

        <Directory Id="TARGETDIR" Name="SourceDir">
            <Directory Id="ProgramFiles64Folder">
                <Directory Id="INSTALLDIR" Name="DiskRaptor">

                    <!-- Per-machine: the exe lives in Program Files, so the file
                         itself can be the component keypath (no HKCU keypath
                         needed, unlike a per-user install). -->
                    <Component Id="MainExecutable" Guid="{A1C3E4F2-6B7D-4E58-9C21-0D3F5A8B7C64}" Win64="yes">
                        <File Id="DiskRaptorExe"
                              Source="$(var.PayloadDir)\diskraptor.exe"
                              KeyPath="yes"
                              Checksum="yes"/>
                    </Component>

                    <Component Id="UninstallShortcut" Guid="{C3E5A6B4-8D9F-4A7B-BE43-2F5B7C0D9E86}">
                        <Shortcut Id="UninstallShortcut"
                                  Name="Uninstall DiskRaptor"
                                  Description="Uninstalls DiskRaptor"
                                  Target="[System64Folder]msiexec.exe"
                                  Arguments="/x [ProductCode]"/>
                        <RemoveFolder Id="INSTALLDIR" On="uninstall"/>
                        <RegistryValue Root="HKCU"
                                       Key="Software\Hansjoerg Hofer\DiskRaptor"
                                       Name="Uninstaller Shortcut" Type="integer" Value="1"
                                       KeyPath="yes"/>
                    </Component>
                </Directory>
            </Directory>

            <Directory Id="ProgramMenuFolder">
                <Directory Id="ApplicationProgramsFolder" Name="DiskRaptor">
                    <Component Id="ApplicationShortcut" Guid="{D4F6B7C5-9EA0-4B8C-CF54-3A6C8D1EAF97}">
                        <Shortcut Id="ApplicationStartMenuShortcut"
                                  Name="DiskRaptor"
                                  Description="Runs DiskRaptor"
                                  Target="[INSTALLDIR]diskraptor.exe"
                                  WorkingDirectory="INSTALLDIR"
                                  Icon="ProductIcon"/>
                        <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall"/>
                        <RegistryValue Root="HKCU"
                                       Key="Software\Hansjoerg Hofer\DiskRaptor"
                                       Name="Start Menu Shortcut" Type="integer" Value="1"
                                       KeyPath="yes"/>
                    </Component>
                </Directory>
            </Directory>
        </Directory>

        <Feature Id="MainProgram" Title="DiskRaptor" Level="1">
            <ComponentRef Id="MainExecutable"/>
            <ComponentRef Id="ApplicationShortcut"/>
            <ComponentRef Id="UninstallShortcut"/>
        </Feature>

        <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLDIR]" After="CostFinalize"/>
    </Product>
</Wix>
