<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Mac App Store sandbox (required for MAS) -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.application-identifier</key>
    <string>7TK444BCPC.diskraptor</string>

    <!-- Required for file system access to user-selected files and folders -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- Required for outbound network access (update checks, etc.) -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Required by WebKit/WebView for JavaScript JIT compilation -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Required by WebKit to load system WebKit frameworks -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Required by WebKit for JIT and W^X memory regions -->
    <key>com.apple.security.cs.disable-executable-page-protection</key>
    <true/>
</dict>
</plist>
