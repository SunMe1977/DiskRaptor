# Build signing secrets (sourced by build.sh / build.cmd)
# Copy this file to .env and fill in your values.

# macOS code signing identity (from `security find-identity -v -p basic`)
SIGNING_IDENTITY="3rd Party Mac Developer Application: Hansjoerg Hofer (7TK444BCPC)"

# macOS notarization Apple ID credentials
APPLE_ID="your@appleid.com"
APPLE_TEAM_ID="XXXXXXXXXX"
APPLE_APP_SPECIFIC_PASSWORD="xxxx-xxxx-xxxx-xxxx"

# Windows code signing (signtool)
SIGNTOOL_CERT_PATH="/path/to/certificate.pfx"
SIGNTOOL_PASSWORD=""

# GitHub Personal Access Token (for release upload)
GITHUB_TOKEN="ghp_xxxxxxxxxxxxxxxxxxxx"
