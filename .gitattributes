# Normalize line endings to LF for all text files (keeps scripts/Cargo.lock
# consistent across OS and avoids CRLF breaks, e.g. version checks).
* text=auto

*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.nsi text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.bat text eol=lf
*.cmd text eol=lf
*.rs text eol=lf
*.py text eol=lf
*.lock text eol=lf

# Binary files must never be normalized.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.icns binary
*.pdf binary
*.mp4 binary
*.exe binary
