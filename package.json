{
  "name": "diskraptor",
  "version": "1.0.0",
  "private": true,
  "description": "Ultra-fast disk space analyzer",
  "scripts": {
    "test:ui": "node test_ui.mjs",
    "test:ui:playwright": "node tests/downloads-cleanup.spec.mjs",
    "test:scanner": "cd src-tauri && cargo run --example scanner_test -- /tmp",
    "test:lint": "for f in frontend/*.js; do node --check \"$f\"; done",
    "test": "node run_tests.mjs",
    "test:quick": "node run_tests.mjs --quick",
    "test:list": "node run_tests.mjs --list",
    "test:scan": "node test_scan_ui.mjs",
    "test:welcome": "node test_welcome_ui.mjs",
    "test:settings": "node test_settings_ui.mjs",
    "test:tree": "node test_tree_ui.mjs",
    "test:topfiles": "node test_topfiles_ui.mjs",
    "test:theme": "node test_theme_ui.mjs",
    "test:context-menu": "node test_context_menu_ui.mjs",
    "test:galaxy": "node test_galaxy_ui.mjs",
    "test:menus": "node test_menus_ui.mjs",
    "test:export": "node test_export_ui.mjs",
    "test:favorites": "node test_favorites_ui.mjs",
    "test:filters": "node test_filters_ui.mjs",
    "test:find": "node test_find_ui.mjs",
    "test:duplicates": "node test_duplicates_ui.mjs",
    "test:i18n": "node test_i18n_ui.mjs",
    "test:fileops": "node test_fileops_ui.mjs",
    "test:progress": "node test_progress_ui.mjs",
    "test:rescan": "node test_rescan_ui.mjs",
    "test:trash": "node test_trash_ui.mjs",
    "test:trash-recovery": "node test_trash_recovery_ui.mjs",
    "test:bridge": "node test_bridge_ui.mjs",
    "test:integration": "node test_integration_ui.mjs"
  },
  "dependencies": {
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "playwright": "^1.62.0",
    "eslint": "^8.0.0"
  }
}
