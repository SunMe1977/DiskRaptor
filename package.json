{
  "name": "diskraptor",
  "version": "1.0.8",
  "private": true,
  "description": "Ultra-fast disk space analyzer",
  "scripts": {
    "test:ui": "node tests/test_ui.mjs",
    "test:ui:playwright": "node tests/downloads-cleanup.spec.mjs",
    "test:scanner": "cd src-tauri && cargo run --example scanner_test -- /tmp",
    "test:lint": "for f in frontend/*.js; do node --check \"$f\"; done",
    "test": "node tests/run_tests.mjs",
    "test:quick": "node tests/run_tests.mjs --quick",
    "test:list": "node tests/run_tests.mjs --list",
    "test:scan": "node tests/test_scan_ui.mjs",
    "test:welcome": "node tests/test_welcome_ui.mjs",
    "test:settings": "node tests/test_settings_ui.mjs",
    "test:tree": "node tests/test_tree_ui.mjs",
    "test:topfiles": "node tests/test_topfiles_ui.mjs",
    "test:theme": "node tests/test_theme_ui.mjs",
    "test:context-menu": "node tests/test_context_menu_ui.mjs",
    "test:galaxy": "node tests/test_galaxy_ui.mjs",
    "test:menus": "node tests/test_menus_ui.mjs",
    "test:export": "node tests/test_export_ui.mjs",
    "test:favorites": "node tests/test_favorites_ui.mjs",
    "test:filters": "node tests/test_filters_ui.mjs",
    "test:find": "node tests/test_find_ui.mjs",
    "test:duplicates": "node tests/test_duplicates_ui.mjs",
    "test:i18n": "node tests/test_i18n_ui.mjs",
    "test:fileops": "node tests/test_fileops_ui.mjs",
    "test:progress": "node tests/test_progress_ui.mjs",
    "test:rescan": "node tests/test_rescan_ui.mjs",
    "test:trash": "node tests/test_trash_ui.mjs",
    "test:trash-recovery": "node tests/test_trash_recovery_ui.mjs",
    "test:bridge": "node tests/test_bridge_ui.mjs",
    "test:integration": "node tests/test_integration_ui.mjs"
  },
  "dependencies": {
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "playwright": "^1.62.0",
    "eslint": "^8.0.0"
  }
}
